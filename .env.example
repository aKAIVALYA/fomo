# One .env at the repo root, read by api, indexer and vite (browser only sees VITE_*)

# ---------- shared (api + indexer) ----------
# Postgres now; enable Timescale on the same DB later, no new var needed
# Local dev: `bun run db:local`, then postgres://postgres@127.0.0.1:5434/postgres
# Tables are created by the api on first start.
DATABASE_URL=postgres://postgres@127.0.0.1:5434/postgres
DB_POOL_MAX=1   # local PGlite only; remove for real Postgres
# Mainnet RPC (Helius/Triton/QuickNode). Public RPC will rate-limit the indexer.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=XXX

# ---------- api ----------
PORT=3000
# Privy dashboard → App settings. Logins are checked against the app's JWKS URL; no app secret needed.
PRIVY_APP_ID=
# Jupiter (portal.jup.ag)
JUPITER_API_URL=https://api.jup.ag
JUPITER_API_KEY=
# 10 bps = 0.1%. Fees land in this wallet's USDC token account, which must already exist.
FEE_BPS=10
FEE_WALLET=

# ---------- web ----------
VITE_PRIVY_APP_ID=
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=XXX
