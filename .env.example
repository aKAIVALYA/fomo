# One .env at the repo root, read by api, indexer and vite (browser only sees VITE_*)

# ---------- shared (api + indexer) ----------
# Postgres now; enable Timescale on the same DB later, no new var needed
# Local dev: `bun run db:local`, then postgres://postgres@127.0.0.1:5434/postgres
# Tables are created by the api on first start.
DATABASE_URL=postgres://postgres@127.0.0.1:5434/postgres
DB_POOL_MAX=1   # local PGlite only; remove for real Postgres
# Mainnet RPC (Helius/Triton/QuickNode). Public RPC will rate-limit the indexer.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=XXX

# ---------- api ----------
PORT=3000
# Privy dashboard → App settings. Logins are checked against the app's JWKS URL; no app secret needed.
PRIVY_APP_ID=
# Jupiter (portal.jup.ag)
JUPITER_API_URL=https://api.jup.ag
JUPITER_API_KEY=
# 10 bps = 0.1%. Fees land in this wallet's USDC token account, which must already exist.
FEE_BPS=10
FEE_WALLET=

# ---------- gasless ----------
# Solana: a hot wallet that pays network fees + token-account rent so users never need SOL.
# Paste the secret key as a JSON array (the contents of a `solana-keygen new -o sponsor.json` file) and fund it with a little SOL.
# New token accounts are repaid to it in USDC. Leave empty and users pay their own gas.
SPONSOR_KEY=
# Base: Privy pays the gas. Turn on Fee sponsorship for Base in the Privy dashboard (needs TEE execution
# and "allow transactions from the client"), then set this to `on`. Otherwise users need a little ETH on Base.
EVM_GASLESS=

# ---------- multichain (Relay does EVM + cross-chain swaps) ----------
# Optional: higher rate limits (dashboard.relay.link)
RELAY_API_KEY=
# EVM address that collects the FEE_BPS platform fee on Relay trades (claim it in the Relay dashboard). Empty = no fee there.
RELAY_FEE_WALLET=
# Optional: the public Base RPC is rate-limited
BASE_RPC_URL=https://mainnet.base.org

# ---------- web ----------
VITE_PRIVY_APP_ID=
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=XXX
VITE_BASE_RPC_URL=https://mainnet.base.org
